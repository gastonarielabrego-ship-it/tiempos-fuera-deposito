# Base de datos: Neon (Lakebase Postgres)
# Variable requerida: DATABASE_URL (pooled, recomendada para serverless/Vercel)
# Formato: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# URL directa (sin pooler), para migraciones o sesiones largas
# DATABASE_URL_UNPOOLED=
